{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desk",
  "version": "0.1.0",
  "identifier": "com.hoodoptimizer.desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Desk",
        "width": 1100,
        "height": 720,
        "minWidth": 160,
        "minHeight": 90,
        "decorations": false,
        "resizable": true,
        "shadow": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' asset: https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English", "Finnish"],
        "customLanguageFiles": {
          "Finnish": "nsis/Finnish.nsh"
        }
      }
    }
  }
}
